<?xml version="1.0" encoding="utf-8"?>
<!--
  Domitara house mark, mirroring apps/web/public/favicon.svg. The 32x32 artwork
  is scaled 2x and centred inside the 108x108 adaptive-icon safe zone. Door and
  windows are painted in the launcher background blue so they read as cut-outs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="22"
        android:translateY="22"
        android:scaleX="2"
        android:scaleY="2">
        <!-- House silhouette -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M16 5L4 14.5h3V27h18V14.5h3L16 5z" />
        <!-- Door -->
        <path
            android:fillColor="#2563EB"
            android:pathData="M13 19h6v8h-6z" />
        <!-- Left window -->
        <path
            android:fillColor="#2563EB"
            android:pathData="M7 16h4v4h-4z" />
        <!-- Right window -->
        <path
            android:fillColor="#2563EB"
            android:pathData="M21 16h4v4h-4z" />
    </group>
</vector>
