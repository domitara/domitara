# Database connection string (required)
DATABASE_URL=postgres://postgres:password@localhost:5432/domitara?sslmode=disable

# JWT signing secret — must be a long random string in production (required in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Server port (default: 8080)
PORT=8080

# Environment: development | production
ENV=development

# Comma-separated list of additional allowed CORS origins (optional)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=

# Set to "true" to expose /openapi.json and /docs in production (default: hidden)
SHOW_API_DOCS=
